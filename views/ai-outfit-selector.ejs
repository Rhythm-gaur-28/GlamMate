<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | GlamMate</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .header {
            text-align: center;
            color: white;
            margin-bottom: 40px;
        }

        .header h1 {
            font-size: 2.5em;
            margin-bottom: 10px;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
        }

        .header p {
            font-size: 1.2em;
            opacity: 0.95;
        }

        .selector-card {
            background: white;
            border-radius: 20px;
            padding: 40px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            margin-bottom: 30px;
        }

        .form-section {
            margin-bottom: 30px;
        }

        .form-section h3 {
            color: #667eea;
            margin-bottom: 15px;
            font-size: 1.3em;
        }

        .options-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 15px;
            margin-top: 15px;
        }

        .option-btn {
            padding: 15px 20px;
            border: 2px solid #e0e0e0;
            background: white;
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.3s ease;
            font-size: 1em;
            text-align: center;
        }

        .option-btn:hover {
            border-color: #667eea;
            background: #f8f9ff;
            transform: translateY(-2px);
        }

        .option-btn.selected {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-color: #667eea;
            font-weight: bold;
        }

        .find-btn {
            width: 100%;
            padding: 18px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 12px;
            font-size: 1.2em;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-top: 20px;
        }

        .find-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(102, 126, 234, 0.4);
        }

        .find-btn:active {
            transform: translateY(0);
        }

        .find-btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

        .results-section {
            display: none;
        }

        .results-section.show {
            display: block;
        }

        .results-header {
            text-align: center;
            margin-bottom: 30px;
        }

        .results-header h2 {
            color: white;
            font-size: 2em;
            margin-bottom: 10px;
        }

        .results-header p {
            color: rgba(255,255,255,0.9);
            font-size: 1.1em;
        }

        .outfits-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 25px;
        }

        .outfit-card {
            background: white;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .outfit-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 40px rgba(0,0,0,0.3);
        }

        .outfit-image {
            width: 100%;
            height: 300px;
            object-fit: cover;
        }

        .outfit-info {
            padding: 15px;
        }

        .outfit-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 10px;
        }

        .tag {
            padding: 5px 12px;
            background: #f0f0f0;
            border-radius: 20px;
            font-size: 0.85em;
            color: #555;
        }

        .tag.primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }

        .similarity-score {
            text-align: center;
            padding: 8px;
            background: #f8f9ff;
            border-radius: 8px;
            font-weight: bold;
            color: #667eea;
        }

        .loading {
            text-align: center;
            padding: 40px;
            color: white;
            font-size: 1.2em;
        }

        .loading-spinner {
            border: 4px solid rgba(255,255,255,0.3);
            border-top: 4px solid white;
            border-radius: 50%;
            width: 50px;
            height: 50px;
            animation: spin 1s linear infinite;
            margin: 20px auto;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .error-message {
            background: #ff4444;
            color: white;
            padding: 15px;
            border-radius: 10px;
            margin: 20px 0;
            text-align: center;
        }

        .back-btn {
            display: inline-block;
            padding: 12px 30px;
            background: white;
            color: #667eea;
            border-radius: 25px;
            text-decoration: none;
            font-weight: bold;
            margin-bottom: 20px;
            transition: all 0.3s ease;
        }

        .back-btn:hover {
            background: #f8f9ff;
            transform: translateY(-2px);
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>✨ AI Fashion Finder</h1>
            <p>Powered by CLIP Vision AI - Find your perfect outfit</p>
        </div>

        <!-- Selection Form -->
        <div class="selector-card" id="selectorForm">
            <a href="/" class="back-btn">← Back to Home</a>

            <!-- Occasion -->
            <div class="form-section">
                <h3>📅 What's the Occasion?</h3>
                <div class="options-grid">
                    <button class="option-btn" data-option="occasion" data-value="casual">Casual Hangout</button>
                    <button class="option-btn" data-option="occasion" data-value="work">Work/Office</button>
                    <button class="option-btn" data-option="occasion" data-value="party">Party</button>
                    <button class="option-btn" data-option="occasion" data-value="formal">Formal Event</button>
                    <button class="option-btn" data-option="occasion" data-value="date">Date</button>
                    <button class="option-btn" data-option="occasion" data-value="wedding">Wedding</button>
                </div>
            </div>

            <!-- Weather -->
            <div class="form-section">
                <h3>🌤️ What's the Weather?</h3>
                <div class="options-grid">
                    <button class="option-btn" data-option="weather" data-value="hot">Hot & Sunny</button>
                    <button class="option-btn" data-option="weather" data-value="cold">Cold</button>
                    <button class="option-btn" data-option="weather" data-value="rainy">Rainy</button>
                    <button class="option-btn" data-option="weather" data-value="moderate">Pleasant</button>
                </div>
            </div>

            <!-- Time of Day -->
            <div class="form-section">
                <h3>⏰ Time of Day?</h3>
                <div class="options-grid">
                    <button class="option-btn" data-option="time" data-value="morning">Morning</button>
                    <button class="option-btn" data-option="time" data-value="afternoon">Afternoon</button>
                    <button class="option-btn" data-option="time" data-value="evening">Evening</button>
                    <button class="option-btn" data-option="time" data-value="night">Night</button>
                </div>
            </div>

            <!-- Style (Optional) -->
            <div class="form-section">
                <h3>✨ Preferred Style? (Optional)</h3>
                <div class="options-grid">
                    <button class="option-btn" data-option="style" data-value="casual">Casual & Comfy</button>
                    <button class="option-btn" data-option="style" data-value="formal">Professional</button>
                    <button class="option-btn" data-option="style" data-value="trendy">Trendy & Bold</button>
                    <button class="option-btn" data-option="style" data-value="elegant">Elegant</button>
                    <button class="option-btn" data-option="style" data-value="minimalist">Minimalist</button>
                </div>
            </div>

            <button class="find-btn" id="findOutfitsBtn">
                🔍 Find My Perfect Outfits
            </button>
        </div>

        <!-- Results Section -->
        <div class="results-section" id="resultsSection">
            <div class="results-header">
                <h2>🎯 Your Perfect Matches</h2>
                <p id="resultsQuery"></p>
            </div>
            
            <div id="loadingIndicator" class="loading" style="display: none;">
                <div class="loading-spinner"></div>
                <p>AI is finding your perfect outfits...</p>
            </div>

            <div id="errorMessage" class="error-message" style="display: none;"></div>

            <div class="outfits-grid" id="outfitsGrid"></div>

            <button class="find-btn" onclick="resetForm()">🔄 Try Different Options</button>
        </div>
    </div>

    <script>
        const selections = {
            occasion: null,
            weather: null,
            time: null,
            style: null
        };

        // Handle option selection
        document.querySelectorAll('.option-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const option = this.dataset.option;
                const value = this.dataset.value;

                // Remove selected class from siblings
                document.querySelectorAll(`[data-option="${option}"]`).forEach(b => {
                    b.classList.remove('selected');
                });

                // Toggle selection
                if (selections[option] === value) {
                    selections[option] = null;
                } else {
                    selections[option] = value;
                    this.classList.add('selected');
                }

                console.log('Selections:', selections);
            });
        });

        // Find outfits
        document.getElementById('findOutfitsBtn').addEventListener('click', async function() {
            // Validate required fields
            if (!selections.occasion || !selections.weather || !selections.time) {
                alert('Please select occasion, weather, and time of day');
                return;
            }

            // Show loading
            document.getElementById('selectorForm').style.display = 'none';
            document.getElementById('resultsSection').classList.add('show');
            document.getElementById('loadingIndicator').style.display = 'block';
            document.getElementById('errorMessage').style.display = 'none';
            document.getElementById('outfitsGrid').innerHTML = '';

            try {
                // Call AI recommendations API
                const response = await fetch('/api/ai-recommendations', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(selections)
                });

                const data = await response.json();

                document.getElementById('loadingIndicator').style.display = 'none';

                if (data.success && data.recommendations.length > 0) {
                    displayResults(data);
                } else {
                    showError('No outfits found. Try different preferences or we need to process more images!');
                }

            } catch (error) {
                document.getElementById('loadingIndicator').style.display = 'none';
                showError('Error connecting to AI service: ' + error.message);
                console.error('Error:', error);
            }
        });

        function displayResults(data) {
            document.getElementById('resultsQuery').textContent = `Query: "${data.query}" | Found ${data.count} matches`;

            const grid = document.getElementById('outfitsGrid');
            grid.innerHTML = '';

            data.recommendations.forEach(outfit => {
                const card = createOutfitCard(outfit);
                grid.appendChild(card);
            });
        }

        function createOutfitCard(outfit) {
    const card = document.createElement('div');
    card.className = 'outfit-card';

    // Use the full file_path from MongoDB directly
    let imageUrl = '';
    if (outfit.file_path) {
        // Convert backslashes to forward slashes and add leading slash
        imageUrl = '/' + outfit.file_path.replace(/\\/g, '/');
    } else {
        // Fallback
        imageUrl = `/ai-system/data/raw/DeepFashion2 Resized/resized/${outfit.split}/${outfit.file_name}`;
    }

    console.log('Loading image:', imageUrl); // Debug

    card.innerHTML = `
        <img src="${imageUrl}" alt="Outfit" class="outfit-image" 
             onerror="this.src='https://placehold.co/300x400/cccccc/666?text=Image+Not+Found'">
        <div class="outfit-info">
            <div class="outfit-tags">
                ${outfit.style ? `<span class="tag primary">${outfit.style}</span>` : ''}
                ${outfit.formality ? `<span class="tag">${outfit.formality}</span>` : ''}
                ${outfit.occasions ? outfit.occasions.map(o => `<span class="tag">${o}</span>`).join('') : ''}
            </div>
            <div class="similarity-score">
                ${(outfit.similarity_score * 100).toFixed(1)}% Match
            </div>
        </div>
    `;

    return card;
}


        function showError(message) {
            const errorDiv = document.getElementById('errorMessage');
            errorDiv.textContent = message;
            errorDiv.style.display = 'block';
        }

        function resetForm() {
            // Reset selections
            Object.keys(selections).forEach(key => selections[key] = null);
            document.querySelectorAll('.option-btn').forEach(btn => {
                btn.classList.remove('selected');
            });

            // Show form, hide results
            document.getElementById('selectorForm').style.display = 'block';
            document.getElementById('resultsSection').classList.remove('show');
        }
    </script>
</body>
</html>
